# Melogold server environment (API §10). Copy to .env for `npm run dev`
# (node --env-file-if-exists=.env). Every variable is optional; commented lines show the defaults.
# The container image sets NODE_ENV=production, HOST=0.0.0.0, DATA_DIR=/data and
# DATABASE_URL=sqlite:///data/melogold.db itself.

# ----- Local development -----------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATA_DIR=./.data
DATABASE_URL=sqlite://./.data/melogold.db
# PostgreSQL 18 from compose.dev.yml (npm run db:up):
# DATABASE_URL=postgres://melogold:melogold@127.0.0.1:55432/melogold
LOG_LEVEL=debug
REGISTRATION=open

# ----- Instance --------------------------------------------------------------
# NODE_ENV=production                      # development|test|production
# HOST=127.0.0.1
# PORT=8080
# PUBLIC_URL=                              # absolute http(s) URL without a trailing /
# INSTANCE_NAME=Melogold                   # 1..64
# SOURCE_URL=https://github.com/melogold-app/melogoldServer/tree/{rev}   # {rev} -> GIT_SHA; required for modified versions (AGPL §13)
# PRIVACY_URL=
# CONTACT=

# ----- Storage ---------------------------------------------------------------
# DATA_DIR=/data                           # SQLite, secret.key, .tmp/
# DATABASE_URL=sqlite:///data/melogold.db  # sqlite://<path> | sqlite::memory: (tests only) | postgres:// | postgresql://
# SQLITE_BUSY_TIMEOUT_MS=5000              # 100..60000
# SQLITE_SYNCHRONOUS=FULL                  # FULL|NORMAL
# DATABASE_POOL_MAX=10                     # 1..50, PostgreSQL only
# DATABASE_SSL=disable                     # disable|require|verify-full
# DATABASE_SSL_CA_FILE=
# DATABASE_STATEMENT_TIMEOUT_MS=15000      # PostgreSQL
# MIGRATE_ON_START=true
# SCHEMA_CHECK=strict                      # strict|warn

# ----- HTTP ------------------------------------------------------------------
# LOG_LEVEL=info                           # fatal|error|warn|info|debug|trace|silent
# TRUST_PROXY=                             # comma-separated IP/CIDR (proxy-addr); empty = do not trust X-Forwarded-For
# CORS_ORIGINS=                            # comma-separated origins
# HTTP_COMPRESSION=true
# OPENAPI_DOCS_UI=false
# SHUTDOWN_GRACE_MS=10000

# ----- Sessions and accounts -------------------------------------------------
# MELOGOLD_SECRET_KEY=                     # 64 hex; empty -> $DATA_DIR/secret.key (always created if missing)
# ACCESS_TOKEN_TTL_SECONDS=900             # 300..3600
# REFRESH_TOKEN_TTL_DAYS=90                # 7..365, sliding
# REFRESH_GRACE_SECONDS=86400              # 60..604800
# RESTORE_REFRESH_GRACE_DAYS=3             # 0..14
# REGISTRATION=first                       # open|closed|first
# REGISTRATION_POW_BITS=0                  # 0..26, 0 = off
# REGISTRATION_POW_SOFT_PER_HOUR=60
# RESERVED_LOGINS=                         # comma-separated
# MAX_DEVICES_PER_USER=20                  # 0 = unlimited
# DEVICE_INACTIVE_DAYS=180
# NEW_DEVICE_RESTRICT_HOURS=24
# LINK_TTL_SECONDS=300                     # 60..900
# LINK_NETWORK_HINT=true
# ARGON2_MEMORY_KIB=65536                  # >= 19456
# ARGON2_TIME_COST=3                       # >= 2
# ARGON2_PARALLELISM=1                     # 1..4
# ARGON2_MAX_CONCURRENCY=2
# ARGON2_QUEUE_LIMIT=32

# ----- Live events and limits ------------------------------------------------
# SSE_HEARTBEAT_SECONDS=25                 # 5..60
# SSE_MAX_STREAMS_PER_DEVICE=4
# SSE_MAX_STREAMS_PER_USER=64
# RATE_LIMIT_ENABLED=true

# ----- Retention -------------------------------------------------------------
# HISTORY_RETENTION_DAYS=400               # >= 366
# HISTORY_MAX_EVENTS=50000
# HISTORY_MERGE_UPLOAD_MAX=20000           # <= HISTORY_MAX_EVENTS
# SYNC_OPS_RETENTION_DAYS=180              # >= 30
# PLAYBACK_RETENTION_DAYS=30
# RETENTION_RUN_AT_UTC=04:30               # HH:MM
# DISK_MIN_FREE_PERCENT=10                 # 1..50

# ----- Set by the image build (read only) ------------------------------------
# APP_VERSION=0.0.0-dev
# GIT_SHA=unknown
# TZ=UTC

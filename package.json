{
  "name": "melogold-server",
  "version": "0.0.0",
  "private": true,
  "description": "Melogold sync server: favorites, library, playlists and history across all of a user's devices.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/melogold-app/melogoldServer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melogold-app/melogoldServer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts serve",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts serve",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TEST_DB=sqlite node --test --test-reporter=spec 'src/**/*.test.ts'",
    "test:pg": "TEST_DB=postgres TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://melogold:melogold@127.0.0.1:55432/melogold} node --test --test-reporter=spec 'src/**/*.test.ts'",
    "openapi": "node scripts/gen-openapi.ts && node scripts/gen-error-codes.ts",
    "openapi:check": "npm run openapi && git diff --exit-code -- openapi spec/error-codes.json && ! git status --porcelain -- openapi spec | grep .",
    "openapi:lint": "redocly lint openapi/openapi.json openapi/openapi.yaml",
    "schema:sql": "node scripts/gen-schema-sql.ts",
    "schema:sql:check": "npm run schema:sql && git diff --exit-code -- docs/schema.sqlite.sql docs/schema.postgres.sql src/db/schema.snapshot.json src/db/types.ts && ! git status --porcelain -- docs/schema.sqlite.sql docs/schema.postgres.sql src/db/schema.snapshot.json src/db/types.ts | grep .",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "~0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.54.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}

# The name clients reach the server by. Without a domain of your own, <ip-with-dashes>.sslip.io resolves to the IP
# and gets a real certificate, e.g. 178-250-187-202.sslip.io.
SITE_ADDRESS=music.example.com
PUBLIC_URL=https://music.example.com
# open | first (only the first account, then closed) | closed
REGISTRATION=first
# INSTANCE_NAME=Melogold
# LOG_LEVEL=info

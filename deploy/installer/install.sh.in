#!/bin/sh
# Melogold server: installation in one command (DESIGN §7.3).
#
#   curl -fsSL https://github.com/melogold-app/melogoldServer/releases/latest/download/install.sh | sh
#   curl -fsSL …/install.sh | sudo sh -s -- --domain music.example.com --admin-login maxim --yes
#   curl -fsSL …/install.sh | sh -s -- --lan --admin-login maxim --yes
#   curl -fsSL …/install.sh | sh -s -- --proxy --public-url https://m.example.com --port 8080 --yes
#   curl -fsSL …/install.sh | sudo sh -s -- --restore ./melogold-backup-….tar.gz
#
# One POSIX sh file built by deploy/installer/build.sh: the templates, the host command and lib.sh are inside.
# Everything is in functions; the last line runs main.
set -eu

INSTALLER_VERSION="@VERSION@"

# @LIB@

# --- messages (--lang ru|en, default from LANG) ----------------------------------------------------------------------

UI_LANG=en
m() { if [ "$UI_LANG" = ru ]; then say "$2"; else say "$1"; fi; }
mw() { if [ "$UI_LANG" = ru ]; then warn "$2"; else warn "$1"; fi; }
md() { if [ "$UI_LANG" = ru ]; then die "$2"; else die "$1"; fi; }
step() { if [ "$UI_LANG" = ru ]; then printf '\n==> %s\n' "$2"; else printf '\n==> %s\n' "$1"; fi; }

# --- options --------------------------------------------------------------------------------------------------------

OPT_DIR=""
OPT_OWNER=""
OPT_MODE=""
OPT_DOMAIN=""
OPT_PORT=""
OPT_PUBLIC_URL=""
OPT_DB=""
OPT_DATABASE_URL=""
OPT_REGISTRATION=""
OPT_ADMIN_LOGIN=""
OPT_NAME=""
OPT_VERSION=""
OPT_IMAGE=""
OPT_SUBNET=""
OPT_INSTALL_DOCKER=0
OPT_YES=0
OPT_NO_START=0
OPT_NO_BACKUP_TIMER=0
OPT_NO_QR=0
OPT_ALLOW_PUBLIC_HTTP=0
OPT_ACTION=""
OPT_PURGE=0
OPT_RESTORE=""

usage() {
	cat <<'EOF'
Usage: install.sh [options]

  --domain FQDN | --lan | --proxy      how clients reach the server (asked when missing)
  --port N                             the app's port (default 8080)
  --public-url URL                     the address clients use (mode proxy)
  --db sqlite|postgres                 the database (default sqlite)
  --database-url URL                   an external PostgreSQL instead of the bundled one
  --registration first|open|closed     who may create accounts (default first: only the owner)
  --admin-login LOGIN                  the owner's account, created before the port opens
  --name NAME                          the server's name shown in the apps
  --version X | --image REF            the server version (default: this installer's)
  --dir DIR  --owner USER              where to install (root: /opt/melogold, else ~/melogold)
  --subnet CIDR                        the Docker network (default 172.30.83.0/24)
  --install-docker  --yes  --no-start  --no-backup-timer  --no-qr  --allow-public-http  --lang ru|en
  --upgrade | --reconfigure | --repair | --uninstall [--purge] | --restore FILE
EOF
}

parse_args() {
	while [ $# -gt 0 ]; do
		case $1 in
			--dir) OPT_DIR=${2:?--dir needs a directory}; shift 2 ;;
			--owner) OPT_OWNER=${2:?--owner needs a user}; shift 2 ;;
			--domain) OPT_MODE=domain; OPT_DOMAIN=${2:?--domain needs a name}; shift 2 ;;
			--lan) OPT_MODE=lan; shift ;;
			--proxy) OPT_MODE=proxy; shift ;;
			--port) OPT_PORT=${2:?--port needs a number}; shift 2 ;;
			--public-url) OPT_PUBLIC_URL=${2:?--public-url needs an address}; shift 2 ;;
			--db) OPT_DB=${2:?--db needs sqlite or postgres}; shift 2 ;;
			--database-url) OPT_DATABASE_URL=${2:?}; OPT_DB=postgres; shift 2 ;;
			--registration) OPT_REGISTRATION=${2:?}; shift 2 ;;
			--admin-login) OPT_ADMIN_LOGIN=${2:?}; shift 2 ;;
			--name) OPT_NAME=${2:?}; shift 2 ;;
			--version) OPT_VERSION=${2:?}; shift 2 ;;
			--image) OPT_IMAGE=${2:?}; shift 2 ;;
			--subnet) OPT_SUBNET=${2:?}; shift 2 ;;
			--install-docker) OPT_INSTALL_DOCKER=1; shift ;;
			--yes | -y) OPT_YES=1; shift ;;
			--no-start) OPT_NO_START=1; shift ;;
			--no-backup-timer) OPT_NO_BACKUP_TIMER=1; shift ;;
			--no-qr) OPT_NO_QR=1; shift ;;
			--allow-public-http) OPT_ALLOW_PUBLIC_HTTP=1; shift ;;
			--lang) UI_LANG=${2:?}; shift 2 ;;
			--upgrade | --reconfigure | --repair | --uninstall | --managed-files) OPT_ACTION=${1#--}; shift ;;
			--purge) OPT_PURGE=1; shift ;;
			--restore) OPT_RESTORE=${2:?--restore needs a backup file}; shift 2 ;;
			--help | -h) usage; exit 0 ;;
			*) usage >&2; die "unknown option: $1" ;;
		esac
	done
	case $UI_LANG in ru | en) ;; *) die "--lang is ru or en" ;; esac
	case $OPT_DB in "" | sqlite | postgres) ;; *) die "--db is sqlite or postgres" ;; esac
	case $OPT_REGISTRATION in "" | first | open | closed) ;; *) die "--registration is first, open or closed" ;; esac
	case $OPT_PORT in *[!0-9]*) die "--port needs a number" ;; esac
	if [ -n "$OPT_NAME" ] && ! env_valid_value "$OPT_NAME"; then die "--name may not contain ' or a line break"; fi
}

detect_lang() {
	case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in ru* | uk* | be* | kk*) UI_LANG=ru ;; esac
}

# Answers a question, or the default without a terminal / with --yes.
prompt() {
	prompt_default=$2
	if [ "$OPT_YES" = 1 ] || ! interactive; then
		printf '%s\n' "$prompt_default"
		return
	fi
	printf '%s [%s]: ' "$1" "$prompt_default" >&2
	read -r prompt_answer || prompt_answer=""
	printf '%s\n' "${prompt_answer:-$prompt_default}"
}

confirm() {
	if [ "$OPT_YES" = 1 ]; then return 0; fi
	ask "$1" "$2"
}

# --- platform and prerequisites -------------------------------------------------------------------------------------

check_platform() {
	PLATFORM_OS=$(uname -s)
	PLATFORM_ARCH=$(uname -m)
	case $PLATFORM_OS in
		Linux) ;;
		Darwin)
			[ "$OPT_MODE" = lan ] || md "macOS is supported only with --lan, for tests" "macOS поддерживается только с --lan, для проверок"
			;;
		*) md "Melogold runs on Linux (x86_64 or aarch64)" "Melogold работает на Linux (x86_64 или aarch64)" ;;
	esac
	case $PLATFORM_ARCH in
		x86_64 | amd64 | aarch64 | arm64) ;;
		armv7* | armv6* | i?86) md "$PLATFORM_ARCH is not supported: use a 64-bit system" "$PLATFORM_ARCH не поддерживается: нужна 64-битная система" ;;
		*) mw "unknown architecture $PLATFORM_ARCH: trying anyway" "неизвестная архитектура $PLATFORM_ARCH: пробую" ;;
	esac
	if [ "$(id -u)" = 0 ]; then IS_ROOT=1; else IS_ROOT=0; fi
	if [ -n "$OPT_DIR" ]; then DIR=$OPT_DIR; elif [ "$IS_ROOT" = 1 ]; then DIR=/opt/melogold; else DIR="${HOME:?}/melogold"; fi
	ENV_FILE="$DIR/.env"
}

version_at_least() {
	# version_at_least HAVE NEED: dotted numbers
	printf '%s\n%s\n' "$2" "$1" | sort -t. -k1,1n -k2,2n -k3,3n -C
}

check_docker() {
	step "Docker" "Docker"
	if ! command -v docker >/dev/null 2>&1; then
		if [ "$OPT_INSTALL_DOCKER" = 1 ] || { interactive && [ "$OPT_YES" != 1 ] && ask "$(m 'Docker is not installed. Install it with get.docker.com?' 'Docker не установлен. Установить через get.docker.com?')" n; }; then
			[ "$IS_ROOT" = 1 ] || md "installing Docker needs root (sudo)" "установка Docker требует root (sudo)"
			command -v curl >/dev/null 2>&1 || md "installing Docker needs curl" "для установки Docker нужен curl"
			curl -fsSL https://get.docker.com | sh
		else
			md "Docker Engine 24+ with Compose 2.20.2+ is needed (or rerun with --install-docker)" \
				"нужен Docker Engine 24+ с Compose 2.20.2+ (или запустите снова с --install-docker)"
		fi
	fi
	DOCKER_VERSION=$(docker version --format '{{.Server.Version}}' 2>/dev/null) ||
		md "cannot talk to Docker: is it running, and may this user use it (group docker)?" \
			"нет связи с Docker: он запущен, и есть ли у пользователя права (группа docker)?"
	version_at_least "${DOCKER_VERSION%%-*}" 24.0.0 || md "Docker $DOCKER_VERSION is too old: 24 or newer is needed" "Docker $DOCKER_VERSION слишком старый: нужен 24 или новее"
	COMPOSE_VERSION=$(docker compose version --short 2>/dev/null) || md "the Docker Compose plugin is missing" "нет плагина Docker Compose"
	COMPOSE_VERSION=${COMPOSE_VERSION#v}
	version_at_least "${COMPOSE_VERSION%%-*}" 2.20.2 || md "Compose $COMPOSE_VERSION is too old: 2.20.2 or newer is needed" "Compose $COMPOSE_VERSION слишком старый: нужен 2.20.2 или новее"
	m "Docker $DOCKER_VERSION, Compose $COMPOSE_VERSION" "Docker $DOCKER_VERSION, Compose $COMPOSE_VERSION"
}

port_busy() {
	if command -v ss >/dev/null 2>&1; then
		ss -Hltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$1\$"
	elif command -v netstat >/dev/null 2>&1; then
		netstat -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$1\$"
	else
		return 1
	fi
}

MEM_KB=0
check_resources() {
	step "Checks" "Проверки"
	if [ -r /proc/meminfo ]; then MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo); fi
	if [ "$MEM_KB" -gt 0 ] && [ "$MEM_KB" -lt 900000 ]; then
		mw "less than 1 GB of RAM: it works, but slowly under load" "меньше 1 ГБ памяти: работать будет, но медленно под нагрузкой"
	fi
	mkdir -p "$DIR"
	DISK_KB=$(df -Pk "$DIR" | awk 'NR == 2 {print $4}')
	if [ "${DISK_KB:-0}" -lt 1048576 ]; then md "less than 1 GB free in $DIR" "в $DIR свободно меньше 1 ГБ"; fi
	if [ "$DISK_KB" -lt 2097152 ]; then mw "less than 2 GB free in $DIR" "в $DIR свободно меньше 2 ГБ"; fi
	if command -v timedatectl >/dev/null 2>&1 && [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" = no ]; then
		mw "the clock is not synchronized (NTP): sign-in tokens depend on it" "часы не синхронизированы (NTP): от них зависят токены входа"
	fi
}

# --- mode, address, database ----------------------------------------------------------------------------------------

is_private_ip() {
	case $1 in
		10.* | 192.168.* | 127.* | 169.254.*) return 0 ;;
		172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) return 0 ;;
		100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) return 0 ;;
	esac
	return 1
}

lan_ip() {
	if command -v ip >/dev/null 2>&1; then
		ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}'
	elif [ "$PLATFORM_OS" = Darwin ]; then
		ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true
	fi
}

choose_mode() {
	if [ -z "$OPT_MODE" ]; then
		if [ "$OPT_YES" = 1 ] || ! interactive; then
			md "choose --domain FQDN, --lan or --proxy" "выберите --domain ИМЯ, --lan или --proxy"
		fi
		m "How will the apps reach this server?" "Как приложения будут подключаться к серверу?"
		m "  1) By a domain name with HTTPS (a server on the internet; ports 80 and 443)" "  1) По доменному имени с HTTPS (сервер в интернете; порты 80 и 443)"
		m "  2) In my home network only (http, by IP address)" "  2) Только в домашней сети (http, по IP-адресу)"
		m "  3) Behind my own reverse proxy on this machine" "  3) За моим обратным прокси на этой машине"
		case $(prompt "$(m 'Choice' 'Выбор')" 1) in
			2) OPT_MODE=lan ;;
			3) OPT_MODE=proxy ;;
			*) OPT_MODE=domain ;;
		esac
	fi
	APP_PORT=${OPT_PORT:-8080}
	LINK_NETWORK_HINT=true
	case $OPT_MODE in
		domain)
			[ -n "$OPT_DOMAIN" ] || OPT_DOMAIN=$(prompt "$(m 'Domain name (e.g. music.example.com)' 'Доменное имя (например, music.example.com)')" "")
			case $OPT_DOMAIN in "" | *[!A-Za-z0-9.-]* | .* | *.) md "not a domain name: $OPT_DOMAIN" "не доменное имя: $OPT_DOMAIN" ;; esac
			SITE=$OPT_DOMAIN
			PUBLIC_URL="https://$OPT_DOMAIN"
			APP_BIND=127.0.0.1
			for mode_port in 80 443; do
				if port_busy "$mode_port"; then
					md "port $mode_port is busy: stop what uses it, or install with --proxy behind your web server" \
						"порт $mode_port занят: остановите то, что его занимает, или ставьте с --proxy за ваш веб-сервер"
				fi
			done
			check_dns
			;;
		lan)
			LAN_IP=$(lan_ip)
			[ -n "$LAN_IP" ] || md "cannot find this machine's address in the network" "не удалось узнать адрес машины в сети"
			if ! is_private_ip "$LAN_IP" && [ "$OPT_ALLOW_PUBLIC_HTTP" != 1 ]; then
				md "$LAN_IP is a public address: plain http there sends passwords openly, and a published Docker port bypasses ufw. Use --domain, or --allow-public-http if you know why" \
					"$LAN_IP — публичный адрес: по http пароли идут открыто, а порт Docker обходит ufw. Используйте --domain или --allow-public-http, если понимаете зачем"
			fi
			SITE=""
			PUBLIC_URL="http://$LAN_IP:$APP_PORT"
			APP_BIND=0.0.0.0
			LINK_NETWORK_HINT=false
			;;
		proxy)
			[ -n "$OPT_PUBLIC_URL" ] || OPT_PUBLIC_URL=$(prompt "$(m 'The public address of your proxy (https://…)' 'Публичный адрес вашего прокси (https://…)')" "")
			case $OPT_PUBLIC_URL in http://* | https://*) ;; *) md "--public-url needs http(s)://…" "--public-url должен быть http(s)://…" ;; esac
			SITE=""
			PUBLIC_URL=${OPT_PUBLIC_URL%/}
			APP_BIND=127.0.0.1
			;;
	esac
	if port_busy "$APP_PORT"; then md "port $APP_PORT is busy: choose another with --port" "порт $APP_PORT занят: выберите другой через --port"; fi
}

check_dns() {
	command -v getent >/dev/null 2>&1 || return 0
	dns_ips=$(getent ahostsv4 "$OPT_DOMAIN" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')
	if [ -z "$dns_ips" ]; then
		mw "$OPT_DOMAIN does not resolve yet: point its A record here before the certificate is requested" \
			"$OPT_DOMAIN пока не резолвится: направьте A-запись сюда, иначе сертификат не выпустится"
		return 0
	fi
	dns_local=$(ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}' | tr '\n' ' ')
	for dns_ip in $dns_ips; do
		case " $dns_local " in *" $dns_ip "*) return 0 ;; esac
	done
	mw "$OPT_DOMAIN points to $dns_ips, this machine has $dns_local: fine behind NAT, otherwise fix the DNS" \
		"$OPT_DOMAIN указывает на $dns_ips, у машины адреса $dns_local: за NAT это нормально, иначе исправьте DNS"
}

choose_subnet() {
	if [ -n "$OPT_SUBNET" ]; then
		MELOGOLD_SUBNET=$OPT_SUBNET
		return
	fi
	subnet_n=83
	while [ "$subnet_n" -lt 100 ]; do
		subnet_used=0
		if command -v ip >/dev/null 2>&1 && ip -4 route 2>/dev/null | grep -q "^172\\.30\\.$subnet_n\\."; then subnet_used=1; fi
		if [ "$subnet_used" = 0 ] && docker network ls -q 2>/dev/null | xargs -r docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null |
			grep -q "172\\.30\\.$subnet_n\\.0/24"; then
			# Our own network from an earlier install is fine.
			docker network inspect melogold_default >/dev/null 2>&1 || subnet_used=1
		fi
		if [ "$subnet_used" = 0 ]; then
			MELOGOLD_SUBNET="172.30.$subnet_n.0/24"
			return
		fi
		subnet_n=$((subnet_n + 1))
	done
	md "no free 172.30.83–99.0/24 subnet: pass one with --subnet" "нет свободной подсети 172.30.83–99.0/24: укажите --subnet"
}

choose_database() {
	MELOGOLD_DB=${OPT_DB:-sqlite}
	DATABASE_URL=""
	POSTGRES_PASSWORD=""
	PROFILES=""
	if [ "$MELOGOLD_DB" = postgres ]; then
		if [ -n "$OPT_DATABASE_URL" ]; then
			DATABASE_URL=$OPT_DATABASE_URL
			mw "an external PostgreSQL: melogold backup and restore handle only the bundled one" \
				"внешний PostgreSQL: melogold backup и restore работают только со встроенным"
		else
			POSTGRES_PASSWORD=$(random_token 32)
			DATABASE_URL="postgres://melogold:$POSTGRES_PASSWORD@postgres:5432/melogold"
			PROFILES=postgres
		fi
	fi
}

memory_settings() {
	APP_HEAP_MB=192
	ARGON2_MAX_CONCURRENCY=2
	if [ "$MEM_KB" -gt 0 ] && [ "$MEM_KB" -lt 1048576 ]; then ARGON2_MAX_CONCURRENCY=1; fi
	# APP_MEM_LIMIT ≥ APP_HEAP_MB + 2·ARGON2_MEMORY (64 MiB) + 128 MiB (DESIGN §7.2): 448 → 512m.
	APP_MEM_LIMIT=512m
	PG_MEM_LIMIT=512m
	PG_SHARED_BUFFERS=128MB
	PG_EFFECTIVE_CACHE_SIZE=384MB
	if [ "$MEM_KB" -gt 0 ] && [ "$MEM_KB" -lt 2097152 ]; then
		PG_MEM_LIMIT=256m
		PG_SHARED_BUFFERS=64MB
		PG_EFFECTIVE_CACHE_SIZE=192MB
	fi
}

# --- files ----------------------------------------------------------------------------------------------------------

# The templates and the host command, inlined by build.sh.
write_compose() {
	cat <<'MELOGOLD_COMPOSE_EOF'
@COMPOSE@
MELOGOLD_COMPOSE_EOF
}

write_caddyfile() {
	cat <<'MELOGOLD_CADDYFILE_EOF'
@CADDYFILE@
MELOGOLD_CADDYFILE_EOF
}

write_host_cli() {
	cat <<'MELOGOLD_HOST_CLI_EOF'
@HOSTCLI@
MELOGOLD_HOST_CLI_EOF
}

# The managed files (DESIGN §7.3 step 9): earlier versions go to .state/prev; compose.override.yaml and caddy.d stay.
install_managed_files() {
	mkdir -p "$DIR/.state/prev" "$DIR/caddy.d" "$DIR/backups"
	chmod 700 "$DIR/backups"
	for managed in compose.yaml Caddyfile melogold; do
		if [ -f "$DIR/$managed" ]; then cp -p "$DIR/$managed" "$DIR/.state/prev/$managed"; fi
	done
	write_compose >"$DIR/compose.yaml.tmp" && mv -f "$DIR/compose.yaml.tmp" "$DIR/compose.yaml"
	write_caddyfile >"$DIR/Caddyfile.tmp" && mv -f "$DIR/Caddyfile.tmp" "$DIR/Caddyfile"
	write_host_cli >"$DIR/melogold.tmp" && chmod 755 "$DIR/melogold.tmp" && mv -f "$DIR/melogold.tmp" "$DIR/melogold"
	printf '%s\n' "$INSTALLER_VERSION" >"$DIR/.state/installer-version"
	if [ "${IS_ROOT:-0}" = 1 ]; then
		ln -sf "$DIR/melogold" /usr/local/bin/melogold
	else
		mkdir -p "$HOME/.local/bin"
		ln -sf "$DIR/melogold" "$HOME/.local/bin/melogold"
	fi
}

# Settings an older .env may lack (upgrades add them, keeping every chosen value).
add_default_settings() {
	env_add_missing "$ENV_FILE" MELOGOLD_SUBNET "172.30.83.0/24"
	env_add_missing "$ENV_FILE" APP_MEM_LIMIT 512m
	env_add_missing "$ENV_FILE" APP_HEAP_MB 192
	env_add_missing "$ENV_FILE" ARGON2_MAX_CONCURRENCY 2
	env_add_missing "$ENV_FILE" LOG_LEVEL info
	env_add_missing "$ENV_FILE" BACKUP_KEEP 14
}

write_env() {
	(
		umask 077
		env_tmp="$ENV_FILE.tmp.$$"
		cat >"$env_tmp" <<EOF
# Melogold server settings, written by install.sh $INSTALLER_VERSION. Values in single quotes, without ' in them.
# Change them with: melogold config set KEY=VALUE
MELOGOLD_IMAGE='$MELOGOLD_IMAGE'
MELOGOLD_MODE='$OPT_MODE'
MELOGOLD_DB='$MELOGOLD_DB'
COMPOSE_PROFILES='$PROFILES'
PUBLIC_URL='$PUBLIC_URL'
SITE='$SITE'
APP_BIND='127.0.0.1'
APP_PORT='$APP_PORT'
INSTANCE_NAME='${OPT_NAME:-Melogold}'
REGISTRATION='$REGISTRATION'
REGISTRATION_POW_BITS='$REGISTRATION_POW_BITS'
TRUST_PROXY='$TRUST_PROXY'
LINK_NETWORK_HINT='$LINK_NETWORK_HINT'
MELOGOLD_SUBNET='$MELOGOLD_SUBNET'
APP_MEM_LIMIT='$APP_MEM_LIMIT'
APP_HEAP_MB='$APP_HEAP_MB'
ARGON2_MAX_CONCURRENCY='$ARGON2_MAX_CONCURRENCY'
DATABASE_URL='$DATABASE_URL'
POSTGRES_PASSWORD='$POSTGRES_PASSWORD'
PG_MEM_LIMIT='$PG_MEM_LIMIT'
PG_SHARED_BUFFERS='$PG_SHARED_BUFFERS'
PG_EFFECTIVE_CACHE_SIZE='$PG_EFFECTIVE_CACHE_SIZE'
LOG_LEVEL='info'
BACKUP_KEEP='14'
EOF
		mv -f "$env_tmp" "$ENV_FILE"
	)
	chmod 600 "$ENV_FILE"
}

# --- the image ------------------------------------------------------------------------------------------------------

pull_image() {
	step "Server image" "Образ сервера"
	if [ -n "$OPT_IMAGE" ]; then
		image_ref=$OPT_IMAGE
	else
		image_version=${OPT_VERSION:-$INSTALLER_VERSION}
		case $image_version in @*) md "this installer has no version: pass --version X" "у этого установщика нет версии: укажите --version X" ;; esac
		image_ref="$MELOGOLD_IMAGE_REPO:$image_version"
	fi
	if ! docker pull "$image_ref"; then
		# A locally built image (tests, air-gapped hosts) is used as it is, without a digest.
		docker image inspect "$image_ref" >/dev/null 2>&1 || md "cannot pull $image_ref" "не удалось скачать $image_ref"
		mw "using the local image $image_ref" "использую локальный образ $image_ref"
	fi
	image_digest=$(docker image inspect -f '{{index .RepoDigests 0}}' "$image_ref" 2>/dev/null | sed -n 's/.*@//p')
	MELOGOLD_IMAGE=$image_ref
	case $image_ref in *@*) ;; *) [ -z "$image_digest" ] || MELOGOLD_IMAGE="$image_ref@$image_digest" ;; esac
	m "$MELOGOLD_IMAGE" "$MELOGOLD_IMAGE"
}

# --- the owner before the port opens (DESIGN §7.3 step 11, M8) ----------------------------------------------------------

OWNER_PASSWORD=""
OWNER_CODE=""
create_owner() {
	[ -n "$OPT_ADMIN_LOGIN" ] || return 0
	step "Owner account" "Аккаунт владельца"
	if [ "$OPT_YES" = 1 ] || ! interactive; then
		owner_out=$(compose exec -T app melogold user add "$OPT_ADMIN_LOGIN" --generate-password) ||
			md "creating the account failed" "не удалось создать аккаунт"
		OWNER_PASSWORD=$(printf '%s\n' "$owner_out" | sed -n 's/^password: //p')
		OWNER_CODE=$(printf '%s\n' "$owner_out" | sed -n 's/^recovery code: //p')
	else
		m "Choose the password of $OPT_ADMIN_LOGIN (at least 10 characters)." "Придумайте пароль для $OPT_ADMIN_LOGIN (не короче 10 символов)."
		compose exec app melogold user add "$OPT_ADMIN_LOGIN" || md "creating the account failed" "не удалось создать аккаунт"
	fi
}

# --- after the start ------------------------------------------------------------------------------------------------

install_backup_timer() {
	[ "$OPT_NO_BACKUP_TIMER" = 1 ] && return 0
	step "Daily backup" "Ежедневный бэкап"
	if [ "$IS_ROOT" = 1 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
		cat >/etc/systemd/system/melogold-backup.service <<EOF
[Unit]
Description=Melogold backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=$DIR/melogold backup --tag daily
EOF
		cat >/etc/systemd/system/melogold-backup.timer <<'EOF'
[Unit]
Description=Melogold backup at 03:30 UTC ± 30 min

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
EOF
		systemctl daemon-reload
		systemctl enable --now melogold-backup.timer >/dev/null
		m "systemd timer melogold-backup: every night, BACKUP_KEEP (14) kept in $DIR/backups" "таймер systemd melogold-backup: каждую ночь, хранится BACKUP_KEEP (14) в $DIR/backups"
	elif command -v crontab >/dev/null 2>&1; then
		cron_minute=$(awk 'BEGIN {srand(); print int(rand() * 60)}')
		(
			crontab -l 2>/dev/null | grep -v "$DIR/melogold backup" || true
			printf '%s 3 * * * %s/melogold backup --tag daily >/dev/null 2>&1\n' "$cron_minute" "$DIR"
		) | crontab -
		m "cron: every night at 03:$cron_minute (local time), BACKUP_KEEP (14) kept" "cron: каждую ночь в 03:$cron_minute (местное время), хранится BACKUP_KEEP (14)"
	else
		mw "no systemd or cron: run melogold backup yourself" "нет ни systemd, ни cron: запускайте melogold backup сами"
	fi
}

open_firewall() {
	case $OPT_MODE in
		domain) firewall_ports="80/tcp 443/tcp 443/udp" ;;
		lan) firewall_ports="$APP_PORT/tcp" ;;
		*) return 0 ;;
	esac
	if command -v ufw >/dev/null 2>&1 && [ "$IS_ROOT" = 1 ] && ufw status 2>/dev/null | grep -q 'Status: active'; then
		if confirm "$(m "Open $firewall_ports in ufw?" "Открыть $firewall_ports в ufw?")" y; then
			for firewall_port in $firewall_ports; do ufw allow "$firewall_port" >/dev/null; done
		fi
	elif command -v firewall-cmd >/dev/null 2>&1 && [ "$IS_ROOT" = 1 ] && firewall-cmd --state >/dev/null 2>&1; then
		if confirm "$(m "Open $firewall_ports in firewalld?" "Открыть $firewall_ports в firewalld?")" y; then
			for firewall_port in $firewall_ports; do firewall-cmd --permanent --add-port="$firewall_port" >/dev/null; done
			firewall-cmd --reload >/dev/null
		fi
	fi
}

wait_public() {
	[ "$OPT_MODE" = domain ] || return 0
	command -v curl >/dev/null 2>&1 || return 0
	step "HTTPS certificate and public address" "HTTPS-сертификат и публичный адрес"
	public_left=180
	until curl -fsS -o /dev/null "$PUBLIC_URL/health" 2>/dev/null; do
		public_left=$((public_left - 5))
		if [ "$public_left" -le 0 ]; then
			mw "$PUBLIC_URL/health does not answer yet. Check that $OPT_DOMAIN points here and port 80 is reachable from the internet; logs: melogold logs caddy" \
				"$PUBLIC_URL/health пока не отвечает. Проверьте, что $OPT_DOMAIN указывает сюда и порт 80 доступен из интернета; логи: melogold logs caddy"
			compose logs --tail 20 caddy >&2 || true
			return 0
		fi
		sleep 5
	done
	m "$PUBLIC_URL answers" "$PUBLIC_URL отвечает"
}

summary() {
	step "Done" "Готово"
	m "Server:      $PUBLIC_URL" "Сервер:      $PUBLIC_URL"
	m "Mode:        $OPT_MODE, database $MELOGOLD_DB" "Режим:       $OPT_MODE, база $MELOGOLD_DB"
	m "Directory:   $DIR" "Каталог:     $DIR"
	if [ -n "$OPT_ADMIN_LOGIN" ]; then
		m "Owner:       $OPT_ADMIN_LOGIN" "Владелец:    $OPT_ADMIN_LOGIN"
		[ -z "$OWNER_PASSWORD" ] || m "Password:    $OWNER_PASSWORD" "Пароль:      $OWNER_PASSWORD"
		[ -z "$OWNER_CODE" ] || m "Recovery:    $OWNER_CODE  (shown once: keep it safe)" "Код восстановления: $OWNER_CODE  (показан один раз: сохраните)"
	fi
	m "Registration: $REGISTRATION" "Регистрация: $REGISTRATION"
	say ""
	m "Commands: melogold status · logs · backup · upgrade · user add <login> · qr" \
		"Команды: melogold status · logs · backup · upgrade · user add <логин> · qr"
	if [ "$OPT_MODE" = lan ]; then
		mw "plain http: fine at home, never forward this port to the internet" "http без шифрования: дома нормально, но не пробрасывайте этот порт в интернет"
	fi
	if [ "$OPT_NO_QR" != 1 ]; then
		say ""
		compose exec -T app melogold qr --color || true
		m "In the app: Settings → Sync → Own server → Scan QR" "В приложении: Настройки → Синхронизация → Свой сервер → Сканировать QR"
	fi
}

# --- actions on an existing installation ------------------------------------------------------------------------------

existing_installation() {
	yes_flag=""
	if [ "$OPT_YES" = 1 ]; then yes_flag=--yes; fi
	case $OPT_ACTION in
		upgrade) exec "$DIR/melogold" upgrade $yes_flag ;;
		uninstall)
			if [ "$OPT_PURGE" = 1 ]; then exec "$DIR/melogold" uninstall --purge; else exec "$DIR/melogold" uninstall; fi
			;;
		repair)
			install_managed_files
			add_default_settings
			compose up -d --remove-orphans
			wait_healthy 120 || md "the server did not become healthy: melogold logs app" "сервер не стал здоровым: melogold logs app"
			m "repaired" "восстановлено"
			exit 0
			;;
		reconfigure) reconfigure ;;
		*)
			if [ -n "$OPT_RESTORE" ]; then exec "$DIR/melogold" restore "$OPT_RESTORE" $yes_flag; fi
			if [ "$OPT_YES" = 1 ] || ! interactive; then
				md "Melogold is already installed in $DIR: add --upgrade, --repair, --reconfigure or --uninstall" \
					"Melogold уже установлен в $DIR: добавьте --upgrade, --repair, --reconfigure или --uninstall"
			fi
			m "Melogold is already installed in $DIR." "Melogold уже установлен в $DIR."
			m "  1) upgrade  2) repair  3) reconfigure  4) uninstall  5) exit" "  1) обновить  2) починить  3) перенастроить  4) удалить  5) выйти"
			case $(prompt "$(m 'Choice' 'Выбор')" 5) in
				1) exec "$DIR/melogold" upgrade ;;
				2) OPT_ACTION=repair; existing_installation ;;
				3) reconfigure ;;
				4) exec "$DIR/melogold" uninstall ;;
				*) exit 0 ;;
			esac
			;;
	esac
}

# --reconfigure: mode, address, port, name, registration; everything else stays.
reconfigure() {
	MELOGOLD_DB=$(env_get "$ENV_FILE" MELOGOLD_DB)
	[ -n "$OPT_MODE" ] || OPT_MODE=$(env_get "$ENV_FILE" MELOGOLD_MODE)
	[ -n "$OPT_PORT" ] || OPT_PORT=$(env_get "$ENV_FILE" APP_PORT)
	if [ "$OPT_MODE" = domain ] && [ -z "$OPT_DOMAIN" ]; then OPT_DOMAIN=$(env_get "$ENV_FILE" SITE); fi
	if [ "$OPT_MODE" = proxy ] && [ -z "$OPT_PUBLIC_URL" ]; then OPT_PUBLIC_URL=$(env_get "$ENV_FILE" PUBLIC_URL); fi
	compose stop app caddy >/dev/null 2>&1 || true
	choose_mode
	MELOGOLD_SUBNET=$(env_get "$ENV_FILE" MELOGOLD_SUBNET)
	env_set "$ENV_FILE" MELOGOLD_MODE "$OPT_MODE"
	env_set "$ENV_FILE" PUBLIC_URL "$PUBLIC_URL"
	env_set "$ENV_FILE" SITE "$SITE"
	env_set "$ENV_FILE" APP_BIND "$APP_BIND"
	env_set "$ENV_FILE" APP_PORT "$APP_PORT"
	env_set "$ENV_FILE" LINK_NETWORK_HINT "$LINK_NETWORK_HINT"
	env_set "$ENV_FILE" TRUST_PROXY "$(trust_proxy)"
	env_set "$ENV_FILE" COMPOSE_PROFILES "$(final_profiles "$(env_get "$ENV_FILE" MELOGOLD_DB)" "$(env_get "$ENV_FILE" DATABASE_URL)")"
	[ -z "$OPT_NAME" ] || env_set "$ENV_FILE" INSTANCE_NAME "$OPT_NAME"
	[ -z "$OPT_REGISTRATION" ] || env_set "$ENV_FILE" REGISTRATION "$OPT_REGISTRATION"
	install_managed_files
	compose up -d --remove-orphans
	wait_healthy 120 || md "the server did not become healthy: melogold logs app" "сервер не стал здоровым: melogold logs app"
	m "reconfigured: $PUBLIC_URL" "перенастроено: $PUBLIC_URL"
	exit 0
}

trust_proxy() {
	case $OPT_MODE in
		domain | proxy) printf '127.0.0.1/32,::1/128,%s\n' "$MELOGOLD_SUBNET" ;;
		*) printf '\n' ;;
	esac
}

# final_profiles DB DATABASE_URL: the compose profiles of the running installation.
final_profiles() {
	final_list=""
	if [ "$1" = postgres ]; then
		case $2 in *@postgres:5432/*) final_list=postgres ;; esac
	fi
	if [ "$OPT_MODE" = domain ]; then final_list=${final_list:+$final_list,}caddy; fi
	printf '%s\n' "$final_list"
}

# --- main -----------------------------------------------------------------------------------------------------------

main() {
	detect_lang
	parse_args "$@"
	check_platform

	if [ "$OPT_ACTION" = managed-files ]; then
		[ -f "$ENV_FILE" ] || die "--managed-files needs an installation in $DIR"
		install_managed_files
		add_default_settings
		exit 0
	fi
	if [ -f "$ENV_FILE" ]; then existing_installation; fi
	case $OPT_ACTION in
		upgrade | repair | reconfigure | uninstall) md "Melogold is not installed in $DIR" "Melogold не установлен в $DIR" ;;
	esac
	if docker volume inspect melogold_data >/dev/null 2>&1 || docker volume inspect melogold_pgdata >/dev/null 2>&1; then
		md "Melogold data volumes exist but $ENV_FILE is missing: new secrets would lock the old data out. Put the old .env back, or install with --restore <backup>" \
			"тома данных Melogold есть, а $ENV_FILE нет: новые секреты отрезали бы старые данные. Верните старый .env или ставьте с --restore <бэкап>"
	fi

	m "Melogold server installer $INSTALLER_VERSION" "Установщик сервера Melogold $INSTALLER_VERSION"
	check_docker
	check_resources
	choose_mode
	choose_subnet
	choose_database
	memory_settings

	REGISTRATION=${OPT_REGISTRATION:-first}
	REGISTRATION_POW_BITS=0
	[ "$REGISTRATION" = open ] && REGISTRATION_POW_BITS=18
	if [ -z "$OPT_RESTORE" ] && [ -z "$OPT_ADMIN_LOGIN" ]; then
		if [ "$OPT_YES" = 1 ] || ! interactive; then
			[ -n "$OPT_REGISTRATION" ] || md "with --yes pass --admin-login LOGIN (or --registration open|closed explicitly)" \
				"с --yes укажите --admin-login ЛОГИН (или явно --registration open|closed)"
		else
			OPT_ADMIN_LOGIN=$(prompt "$(m 'Login of the owner account' 'Логин аккаунта владельца')" "")
			[ -n "$OPT_ADMIN_LOGIN" ] || [ "$REGISTRATION" != first ] ||
				md "mode first needs an owner: pass a login" "режиму first нужен владелец: укажите логин"
		fi
	fi
	TRUST_PROXY=$(trust_proxy)

	pull_image
	step "Files in $DIR" "Файлы в $DIR"
	write_env
	install_managed_files
	if [ -n "$OPT_OWNER" ] && [ "$IS_ROOT" = 1 ]; then chown -R "$OPT_OWNER" "$DIR"; fi
	compose config -q || md "compose rejects the generated files (please report this)" "compose не принимает созданные файлы (сообщите об этом)"

	if [ "$OPT_NO_START" = 1 ]; then
		env_set "$ENV_FILE" APP_BIND "$APP_BIND"
		env_set "$ENV_FILE" COMPOSE_PROFILES "$(final_profiles "$MELOGOLD_DB" "$DATABASE_URL")"
		m "installed without starting: melogold start" "установлено без запуска: melogold start"
		exit 0
	fi

	# The app first, on 127.0.0.1 only and without Caddy: the owner exists before anyone else can reach it.
	step "Starting (closed to the network)" "Запуск (пока закрыт от сети)"
	env_set "$ENV_FILE" COMPOSE_PROFILES "$PROFILES"
	compose up -d
	wait_healthy 180 || {
		compose logs --tail 40 app >&2 || true
		md "the server did not start: see the log above (melogold logs app)" "сервер не запустился: смотрите лог выше (melogold logs app)"
	}
	if [ -n "$OPT_RESTORE" ]; then
		"$DIR/melogold" restore "$OPT_RESTORE" --yes
	else
		create_owner
	fi

	step "Opening to the network" "Открываю для сети"
	env_set "$ENV_FILE" APP_BIND "$APP_BIND"
	env_set "$ENV_FILE" COMPOSE_PROFILES "$(final_profiles "$MELOGOLD_DB" "$DATABASE_URL")"
	compose up -d --remove-orphans
	wait_healthy 120 || md "the server did not become healthy: melogold logs app" "сервер не стал здоровым: melogold logs app"
	install_backup_timer
	open_firewall
	wait_public
	summary
}

main "$@"
